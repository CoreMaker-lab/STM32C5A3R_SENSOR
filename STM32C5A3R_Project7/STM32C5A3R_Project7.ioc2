    "overridePackMappingRules": [
      {
        "selectors": [
          {
            "packVendor": "ARM"
          },
          {
            "packName": "*CMSIS*"
          }
        ],
        "path": "arch/{{packName}}"
      },
      {
        "selectors": [
          {
            "packType": "HAL"
          }
        ],
        "path": "{{packFriendlyName}}"
      },
      {
        "selectors": [
          {
            "packType": "DFP"
          }
        ],
        "path": "{{packFriendlyName}}"
      },
